# Copy to <repo>/.env.ai.local (git-ignored via `.env*.local`) and fill in.

# Claude Code auth inside containers — create with `claude setup-token` on the host
CLAUDE_CODE_OAUTH_TOKEN=

# GitHub fine-grained PAT for this repo: Contents (RW), Pull requests (RW), Metadata (R)
GH_TOKEN=

# Jira Cloud — API token from https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_BASE_URL=https://your-site.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
# Exact status (or transition) names in your workflow
JIRA_STATUS_IN_PROGRESS=In Progress
JIRA_STATUS_IN_REVIEW=In Review

# Figma personal access token (File content: read) — Settings → Security → Personal access tokens
FIGMA_API_KEY=

# Branch that worktrees start from and PRs target
AI_BASE_BRANCH=development

# Optional overrides
# AI_WORKTREES_DIR=/absolute/path/for/worktrees   (default: ../<repo>-worktrees)
# AI_TMUX_SESSION=ai-tasks
# AI_COPY_FILES=".env.local .env.development.local .env.test.local .claude/settings.local.json"
