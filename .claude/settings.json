{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/ai/setup-worktree.sh || true",
            "timeout": 600
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/ai/guard.sh",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": ["Bash(scripts/ai/stop-tree.sh:*)"],
    "deny": [
      "Bash(drizzle-kit push:*)",
      "Bash(npx drizzle-kit push:*)",
      "Bash(git push origin main:*)",
      "Bash(git push origin develop:*)",
      "Edit(.github/**)",
      "Write(.github/**)"
    ]
  }
}
