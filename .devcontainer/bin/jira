#!/usr/bin/env bash
# Minimal Jira Cloud REST helper (bash 3.2 compatible; used on host and in container).
#
# Usage:
#   jira get <KEY>                         Print issue (summary, type, status, description, comments, Figma links)
#   jira json <KEY>                        Print raw issue JSON (summary, issuetype, status)
#   jira transition <KEY> <STATUS>         Move issue to a status (matches transition or target status name)
#   jira comment <KEY> <FILE> [PR_URL]     Add a comment from a text/markdown file (+ optional PR link)
#   jira link <KEY> <URL> <TITLE>          Add a web link (e.g. the PR) to the issue
#
# Env: JIRA_BASE_URL (https://your-site.atlassian.net), JIRA_EMAIL, JIRA_API_TOKEN
set -euo pipefail

: "${JIRA_BASE_URL:?JIRA_BASE_URL is not set}"
: "${JIRA_EMAIL:?JIRA_EMAIL is not set}"
: "${JIRA_API_TOKEN:?JIRA_API_TOKEN is not set}"

api() {
  local method="$1" path="$2" body="${3:-}"
  local args=(-sS --fail-with-body -u "$JIRA_EMAIL:$JIRA_API_TOKEN" -H 'Accept: application/json' -X "$method")
  if [ -n "$body" ]; then
    args+=(-H 'Content-Type: application/json' --data-binary "$body")
  fi
  curl "${args[@]}" "${JIRA_BASE_URL%/}/rest/api/3$path"
}

lower() { printf '%s' "$1" | tr '[:upper:]' '[:lower:]'; }

cmd="${1:-}"
key="${2:-}"
[ -n "$cmd" ] && [ -n "$key" ] || { sed -n '2,12p' "$0"; exit 1; }

case "$cmd" in
  json)
    api GET "/issue/$key?fields=summary,issuetype,status"
    ;;

  get)
    issue="$(api GET "/issue/$key?fields=summary,issuetype,status,description,comment,attachment&expand=renderedFields")"
    echo "$issue" | jq -r '
      "KEY: \(.key)",
      "TITLE: \(.fields.summary)",
      "TYPE: \(.fields.issuetype.name)",
      "STATUS: \(.fields.status.name)",
      "",
      "DESCRIPTION (HTML):",
      (.renderedFields.description // "(empty)"),
      "",
      "ATTACHMENTS:",
      ((.fields.attachment // [])[] | "- \(.filename): \(.content)"),
      "",
      "COMMENTS (HTML):",
      ((.renderedFields.comment.comments // [])[] | "--- \(.author.displayName) @ \(.created)\n\(.body)")'
    echo
    echo "FIGMA LINKS:"
    echo "$issue" | jq -r '[.renderedFields.description, (.renderedFields.comment.comments // [])[].body] | map(. // "") | join("\n")' \
      | sed 's/&amp;/\&/g' \
      | grep -oE 'https://(www\.)?figma\.com/(design|file|proto)/[^"<> ]+' \
      | sort -u || echo "(none)"
    ;;

  transition)
    target="$(lower "${3:?status name required}")"
    transitions="$(api GET "/issue/$key/transitions")"
    id="$(echo "$transitions" | jq -r --arg t "$target" \
      '.transitions[] | select((.name | ascii_downcase) == $t or (.to.name | ascii_downcase) == $t) | .id' | head -n 1)"
    if [ -z "$id" ]; then
      echo "No transition to '$3' available for $key. Available:" >&2
      echo "$transitions" | jq -r '.transitions[] | "  - \(.name) -> \(.to.name)"' >&2
      exit 1
    fi
    api POST "/issue/$key/transitions" "$(jq -n --arg id "$id" '{transition:{id:$id}}')" >/dev/null
    echo "$key -> $3"
    ;;

  comment)
    file="${3:?file required}"
    pr_url="${4:-}"
    # Plain-text/markdown -> Atlassian Document Format: "- " lines become bullets, others paragraphs.
    body="$(jq -Rn --arg pr "$pr_url" '
      def para(t): {type:"paragraph", content:[{type:"text", text:t}]};
      [inputs | select(length > 0)]
      | reduce .[] as $l ([];
          if ($l | test("^\\s*[-*] ")) then
            ($l | sub("^\\s*[-*] "; "")) as $item
            | if (length > 0 and .[-1].type == "bulletList")
              then .[-1].content += [{type:"listItem", content:[para($item)]}]
              else . + [{type:"bulletList", content:[{type:"listItem", content:[para($item)]}]}] end
          elif ($l | test("^#+ ")) then
            . + [{type:"heading", attrs:{level:3}, content:[{type:"text", text:($l | sub("^#+ "; ""))}]}]
          else . + [para($l)] end)
      | if $pr != "" then . + [{type:"paragraph", content:[
          {type:"text", text:"Pull request: "},
          {type:"text", text:$pr, marks:[{type:"link", attrs:{href:$pr}}]}]}] else . end
      | {body:{type:"doc", version:1, content:.}}' < "$file")"
    api POST "/issue/$key/comment" "$body" >/dev/null
    echo "Comment added to $key"
    ;;

  link)
    url="${3:?url required}"
    title="${4:-$url}"
    api POST "/issue/$key/remotelink" "$(jq -n --arg u "$url" --arg t "$title" \
      '{object:{url:$u, title:$t, icon:{url16x16:"https://github.com/favicon.ico", title:"GitHub"}}}')" >/dev/null
    echo "Link added to $key"
    ;;

  *)
    sed -n '2,12p' "$0"
    exit 1
    ;;
esac
