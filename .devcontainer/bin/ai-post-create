#!/usr/bin/env bash
# Runs once when the task container is created (devcontainer postCreateCommand).
set -euo pipefail

echo "▶ Installing dependencies (npm ci)…"
npm ci --prefer-offline --no-audit --no-fund

echo "▶ Writing MCP config for Claude…"
chromium_path="$(find /ms-playwright -type f -name chrome -path '*chromium-*' -not -path '*headless*' | head -n 1)"
mkdir -p "$HOME/.ai" /tmp/ai-artifacts
jq -n --arg chrome "$chromium_path" '{
  mcpServers: {
    playwright: {
      command: "playwright-mcp",
      args: ["--headless", "--browser", "chromium", "--executable-path", $chrome,
             "--no-sandbox", "--isolated", "--viewport-size", "1440,900",
             "--output-dir", "/tmp/ai-artifacts/playwright"]
    },
    figma: {
      command: "figma-developer-mcp",
      args: ["--stdio"],
      env: { FIGMA_API_KEY: "${FIGMA_API_KEY}" }
    }
  }
}' > "$HOME/.ai/mcp.json"

echo "▶ Seeding Claude config (skip onboarding / trust prompts)…"
config_dir="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
mkdir -p "$config_dir"
if [ ! -f "$config_dir/.claude.json" ]; then
  jq -n --arg ws "$PWD" '{
    hasCompletedOnboarding: true,
    bypassPermissionsModeAccepted: true,
    projects: { ($ws): { hasTrustDialogAccepted: true } }
  }' > "$config_dir/.claude.json"
fi

echo "✔ Container ready"
