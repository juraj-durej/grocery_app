{
  "name": "grocery-app-ai",
  "build": { "dockerfile": "Dockerfile", "context": "." },

  // Mount the worktree at the same absolute path as on the host so the
  // worktree's `.git` file (absolute gitdir) resolves inside the container.
  // scripts/ai/run-task.sh additionally mounts the main repo's `.git` dir.
  "workspaceMount": "source=${localWorkspaceFolder},target=${localWorkspaceFolder},type=bind,consistency=cached",
  "workspaceFolder": "${localWorkspaceFolder}",

  "remoteUser": "node",
  "runArgs": ["--shm-size=1g"],

  "mounts": ["source=grocery-app-npm-cache,target=/home/node/.npm,type=volume"],

  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "/home/node/.claude",
    "PLAYWRIGHT_BROWSERS_PATH": "/ms-playwright",
    "NEXT_TELEMETRY_DISABLED": "1"
  },

  // Secrets are only passed at exec time (not baked into the container).
  // They come from `.env.ai.local` via scripts/ai/run-task.sh.
  "remoteEnv": {
    "CLAUDE_CODE_OAUTH_TOKEN": "${localEnv:CLAUDE_CODE_OAUTH_TOKEN}",
    "GH_TOKEN": "${localEnv:GH_TOKEN}",
    "FIGMA_API_KEY": "${localEnv:FIGMA_API_KEY}",
    "JIRA_BASE_URL": "${localEnv:JIRA_BASE_URL}",
    "JIRA_EMAIL": "${localEnv:JIRA_EMAIL}",
    "JIRA_API_TOKEN": "${localEnv:JIRA_API_TOKEN}",
    "JIRA_STATUS_IN_PROGRESS": "${localEnv:JIRA_STATUS_IN_PROGRESS}",
    "JIRA_STATUS_IN_REVIEW": "${localEnv:JIRA_STATUS_IN_REVIEW}",
    "AI_BASE_BRANCH": "${localEnv:AI_BASE_BRANCH}",
    "GIT_AUTHOR_NAME": "${localEnv:GIT_AUTHOR_NAME}",
    "GIT_AUTHOR_EMAIL": "${localEnv:GIT_AUTHOR_EMAIL}",
    "GIT_COMMITTER_NAME": "${localEnv:GIT_AUTHOR_NAME}",
    "GIT_COMMITTER_EMAIL": "${localEnv:GIT_AUTHOR_EMAIL}"
  },

  "postCreateCommand": "ai-post-create",

  "customizations": {
    "vscode": {
      "extensions": [
        "oxc.oxc-vscode",
        "bradlc.vscode-tailwindcss",
        "vitest.explorer",
        "ms-playwright.playwright",
        "lokalise.i18n-ally"
      ]
    }
  }
}
